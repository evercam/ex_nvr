<div class="grow flex justify-center dark:text-white pt-5">
  <div class="mx-auto w-2/3">
    <div class="my-8">
      <h1 class="text-2xl font-bold">Export Footage</h1>
      <p class="mt-2 dark:text-gray-400">
        Export a device's recordings to a folder on local storage
      </p>
    </div>

    <.card class="space-y-6">
      <.simple_form
        id="export-form"
        for={@export_form}
        phx-change="validate"
        phx-submit="submit_export"
      >
        <.input
          field={@export_form[:device_id]}
          type="select"
          label="Device"
          prompt="Select a device"
          options={Enum.map(@devices, &{&1.name, &1.id})}
          disabled={@job_status != :new}
          required
        />
        <div class="grid grid-cols-2 gap-4">
          <.input
            field={@export_form[:start_date]}
            type="datetime-local"
            label="Start Date"
            disabled={@job_status != :new}
            required
          />
          <.input
            field={@export_form[:end_date]}
            type="datetime-local"
            label="End Date"
            disabled={@job_status != :new}
            required
          />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <.input
            field={@export_form[:max_duration]}
            type="number"
            min="1"
            label="Max file duration (seconds)"
            disabled={@job_status != :new}
          />
          <.input
            field={@export_form[:max_file_size_mb]}
            type="number"
            min="1"
            label="Max file size (MiB)"
            disabled={@job_status != :new}
          />
        </div>
        <p class="text-sm dark:text-gray-400">
          Optional — splits the export into multiple files once either limit is reached.
        </p>

        <.separator />

        <div class="w-full font-medium">Destination</div>

        <.input
          :let={option}
          field={@export_form[:storage_mountpoint]}
          type="radio"
          label=""
          options={Enum.map(mounted_candidates(@disks), &{&1.fs.mountpoint, &1})}
        >
          <div class="w-full px-2 font-normal text-xs">
            <div class="flex justify-between mb-1">
              <span>{elem(option, 1).label} — {elem(option, 0)}</span>
              <span>
                {format_bytes(elem(option, 1).fs.avail)} free of {format_bytes(
                  elem(option, 1).fs.size
                )}
              </span>
            </div>
            <div class="w-full bg-gray-200 rounded-full dark:bg-gray-700">
              <div
                class="bg-blue-800 text-xs font-medium text-blue-100 text-center leading-none rounded-full"
                style={"width: #{percent_used(elem(option, 1).fs)}%"}
              >
                {percent_used(elem(option, 1).fs)}% used
              </div>
            </div>
          </div>
        </.input>

        <div
          :for={candidate <- unmounted_candidates(@disks)}
          class="flex items-center justify-between p-2 border border-gray-200 rounded-lg dark:border-gray-600 text-xs"
        >
          <div>
            <span class="font-medium">{candidate.name}</span>
            <span class="text-gray-500 dark:text-gray-400">
              ({candidate.label}, {candidate.fs.type}, {format_bytes(candidate.fs.size)}, not mounted)
            </span>
          </div>
          <button
            type="button"
            phx-click="mount_disk"
            phx-value-part={candidate.name}
            class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
          >
            <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> Mount
          </button>
        </div>

        <.input
          field={@export_form[:folder_name]}
          type="text"
          label="Folder name"
          placeholder="e.g. incident-2026-09-01"
        />
        <p class="text-sm dark:text-gray-400">
          Identifies this export on the chosen storage. Using the same storage and folder name again
          resumes a paused export or retries a failed one; a different folder name always starts a new export.
        </p>

        <.separator />

        <div :if={@job_status == :new} class="flex justify-end">
          <.button type="submit" phx-disable-with="Starting...">
            <.icon name="hero-play-solid" class="w-4 h-4 mr-1" /> Start Export
          </.button>
        </div>

        <div :if={@job_status == :running} class="space-y-3">
          <div class="flex items-center gap-2 text-lg">
            <.icon name="hero-arrow-path" class="h-5 w-5 animate-spin" /> Exporting…
          </div>
          <div class="w-full bg-gray-200 rounded-full dark:bg-gray-700">
            <div
              class="bg-blue-800 text-xs font-medium text-blue-100 text-center leading-none rounded-full"
              style={"width: #{@job_progress.percentage}%"}
            >
              {@job_progress.percentage}%
            </div>
          </div>
          <p class="text-sm dark:text-gray-400">
            Files completed: {@job_progress.files_completed}
          </p>
          <p :if={@job_progress.current_file} class="text-sm dark:text-gray-400">
            Current file: {@job_progress.current_file.filename} ({format_bytes(
              @job_progress.current_file.bytes
            )}, {@job_progress.current_file.elapsed_seconds}s)
          </p>
          <div class="flex justify-end">
            <button
              type="button"
              phx-click="stop_export"
              class="text-red-600 dark:text-red-400 hover:underline"
            >
              Stop
            </button>
          </div>
        </div>

        <div :if={@job_status == :paused} class="space-y-3">
          <p>
            Export paused at {@job_progress.percentage}% ({@job_progress.files_completed} files written).
          </p>
          <div class="flex justify-end">
            <.button type="submit" phx-disable-with="Resuming...">
              <.icon name="hero-play-solid" class="w-4 h-4 mr-1" /> Resume Export
            </.button>
          </div>
        </div>

        <div :if={@job_status == :completed} class="space-y-3">
          <div class="flex items-center gap-2 text-lg">
            <.icon name="hero-check-circle-solid" class="h-5 w-5 text-green-600" />
            Export already complete
          </div>
          <ul class="text-sm dark:text-gray-400">
            <li :for={file <- @job_progress.files}>
              {file.filename} — {format_bytes(file.size)}
            </li>
          </ul>
        </div>

        <div :if={@job_status == :failed} class="space-y-3">
          <p class="text-red-600 dark:text-red-400">Export failed: {@job_progress.error}</p>
          <div class="flex justify-end">
            <.button type="submit" phx-disable-with="Retrying...">
              <.icon name="hero-arrow-path" class="w-4 h-4 mr-1" /> Retry Export
            </.button>
          </div>
        </div>
      </.simple_form>
    </.card>
  </div>
</div>
